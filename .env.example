# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# OpenAI — explanations, query parsing, embeddings, voice input
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIM=1024
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_STT_FALLBACK_MODEL=whisper-1

# 2GIS — live hours, ratings, address search, walking routes, transit, taxi (optional: without a key the own catalog is used)
# several keys, comma-separated: the pool switches to the next one when a key hits its limit
DGIS_API_KEYS=
DGIS_LIMIT_PER_KEY=1000
DGIS_LIMIT_PERIOD=month
